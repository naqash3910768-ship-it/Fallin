<section class="section{% if section.settings.background == 'sand' %} section--sand{% endif %}">
  <div class="container image-text image-text--media-{{ section.settings.media_position }}">
    <div class="image-text__media ratio-4-5" data-reveal>
      {%- render 'image-or-art', image: section.settings.image, icon: section.settings.icon, tone: section.settings.tone, label: section.settings.title -%}
    </div>
    <div class="image-text__content" data-reveal style="--reveal-delay:0.1s;">
      {%- render 'section-heading', eyebrow: section.settings.eyebrow, title: section.settings.title -%}
      {%- if section.settings.text != blank -%}
        <div class="image-text__para">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {%- render 'button', label: section.settings.button_label, url: section.settings.button_url, style: 'ghost', class: 'mt-8' -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Since 1993" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Built on Experience. Designed for Today." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our Story" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "icon",
      "label": "Placeholder icon",
      "default": "factory",
      "options": [
        { "value": "chair", "label": "Chair" },
        { "value": "factory", "label": "Factory" },
        { "value": "resin", "label": "Resin" },
        { "value": "mould", "label": "Mould" },
        { "value": "quality", "label": "Quality" },
        { "value": "finish", "label": "Finish" },
        { "value": "stack", "label": "Stack" }
      ]
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Placeholder tone",
      "default": "sand",
      "options": [
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" },
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "charcoal", "label": "Charcoal" }
      ]
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "sand", "label": "Sand" }
      ]
    }
  ],
  "presets": [
    { "name": "Image with text" }
  ]
}
{% endschema %}
