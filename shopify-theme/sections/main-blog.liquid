<div class="container" style="padding-block:3rem;">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumbs__list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><span aria-hidden="true">/</span><span class="breadcrumbs__current" aria-current="page">{{ blog.title }}</span></li>
    </ol>
  </nav>

  <h1 style="margin-top:1rem; font-size:2rem; font-weight:800; letter-spacing:-0.02em; color:var(--color-ink);">{{ section.settings.heading | default: blog.title }}</h1>
  {%- if section.settings.description != blank -%}
    <p style="margin-top:0.75rem; max-width:36rem; color:var(--color-body-text);">{{ section.settings.description }}</p>
  {%- endif -%}

  {%- paginate blog.articles by 12 -%}
    <div class="blog-grid" style="margin-top:3rem; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="blog-card">
          <div class="blog-card__media">
            {%- render 'image-or-art', image: article.image, icon: 'finish', tone: 'sand', label: article.title -%}
          </div>
          <div class="blog-card__body">
            <div style="display:flex; align-items:center; justify-content:space-between; font-size:0.75rem; color:#737373;">
              <span class="blog-card__category">{{ article.tags.first | default: 'Journal' }}</span>
              <span>{{ article.content | strip_html | size | divided_by: 1200 | at_least: 1 }} min read</span>
            </div>
            <h2 class="blog-card__title">{{ article.title }}</h2>
            <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination" style="margin-top:2.5rem; display:flex; justify-content:center; gap:0.5rem;">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--ghost btn--md">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--ghost btn--md">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog posts list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading override" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Notes on furniture care, materials and manufacturing." }
  ]
}
{% endschema %}
