<section class="section">
  <div class="container">
    <div class="cta-banner">
      <div data-reveal>
        <h2 class="cta-banner__title">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="cta-banner__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <div data-reveal style="--reveal-delay:0.1s;">
          {%- render 'button', label: section.settings.button_label, url: section.settings.button_url, style: 'light', size: 'lg' -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Let's Talk" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Whether you're a homeowner, a retailer or an institutional buyer — we're happy to help you find the right Fello furniture." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact Us" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [
    { "name": "CTA banner" }
  ]
}
{% endschema %}
