<div class="container" style="padding-block:3rem; max-width:48rem; margin-inline:auto;">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumbs__list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><span aria-hidden="true">/</span><span class="breadcrumbs__current" aria-current="page">{{ page.title }}</span></li>
    </ol>
  </nav>
  <h1 style="margin-top:1rem; font-size:2.25rem; font-weight:800; letter-spacing:-0.02em; color:var(--color-ink);">{{ page.title }}</h1>
  <div style="margin-top:2rem; line-height:1.7; color:var(--color-body-text);">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
