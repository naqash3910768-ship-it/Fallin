<footer class="site-footer">
  <div class="container site-footer__top">
    <div>
      <a href="{{ routes.root_url }}" class="site-logo" style="font-size:1.5rem;" aria-label="{{ shop.name }} home">
        {%- if section.settings.logo -%}
          <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" style="filter:brightness(0) invert(1);">
        {%- else -%}
          <span style="color:#fff;">{{ section.settings.logo_text_start | default: 'fell' }}</span>
          <span class="site-logo__accent">
            {{- section.settings.logo_text_end | default: 'o' -}}
            <span class="site-logo__dot" aria-hidden="true"></span>
          </span>
        {%- endif -%}
      </a>
      {%- if section.settings.blurb != blank -%}
        <p class="site-footer__blurb">{{ section.settings.blurb }}</p>
      {%- endif -%}
      <div class="site-footer__social">
        {%- if section.settings.social_facebook_link != blank -%}
          <a href="{{ section.settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="{{ shop.name }} on Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.84c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.9h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"></path></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_instagram_link != blank -%}
          <a href="{{ section.settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="{{ shop.name }} on Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.24 2.22.41.56.21.96.47 1.38.89.42.42.68.82.89 1.38.17.42.36 1.05.41 2.22.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.24 1.8-.41 2.22-.21.56-.47.96-.89 1.38-.42.42-.82.68-1.38.89-.42.17-1.05.36-2.22.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.24-2.22-.41a3.7 3.7 0 0 1-1.38-.89 3.7 3.7 0 0 1-.89-1.38c-.17-.42-.36-1.05-.41-2.22C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.24-1.8.41-2.22.21-.56.47-.96.89-1.38.42-.42.82-.68 1.38-.89.42-.17 1.05-.36 2.22-.41C8.42 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5.01-4.73.07-.96.04-1.48.2-1.82.34-.46.18-.78.39-1.13.73-.34.35-.55.67-.73 1.13-.14.34-.3.86-.34 1.82C3.19 8.5 3.18 8.85 3.18 12s.01 3.5.07 4.73c.04.96.2 1.48.34 1.82.18.46.39.78.73 1.13.35.34.67.55 1.13.73.34.14.86.3 1.82.34 1.23.06 1.58.07 4.73.07s3.5-.01 4.73-.07c.96-.04 1.48-.2 1.82-.34.46-.18.78-.39 1.13-.73.34-.35.55-.67.73-1.13.14-.34.3-.86.34-1.82.06-1.23.07-1.58.07-4.73s-.01-3.5-.07-4.73c-.04-.96-.2-1.48-.34-1.82a3 3 0 0 0-.73-1.13 3 3 0 0 0-1.13-.73c-.34-.14-.86-.3-1.82-.34C15.5 4.01 15.15 4 12 4Zm0 3.38a4.62 4.62 0 1 1 0 9.24 4.62 4.62 0 0 1 0-9.24Zm0 1.8a2.82 2.82 0 1 0 0 5.64 2.82 2.82 0 0 0 0-5.64Zm5.88-2.02a1.08 1.08 0 1 1-2.16 0 1.08 1.08 0 0 1 2.16 0Z"></path></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'column' -%}
        <div {{ block.shopify_attributes }}>
          <h3 class="footer-col__heading">{{ block.settings.heading }}</h3>
          <ul class="footer-col__list">
            {%- for link in block.settings.link_list.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text }}</p>
    <nav class="site-footer__bottom-nav" aria-label="Footer">
      {%- for link in section.settings.bottom_menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to use the text wordmark. Rendered in white."
    },
    {
      "type": "text",
      "id": "logo_text_start",
      "label": "Wordmark — first part",
      "default": "fell"
    },
    {
      "type": "text",
      "id": "logo_text_end",
      "label": "Wordmark — accent letter",
      "default": "o"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Fello Moulded Furniture is manufactured by Polycraft Industries, using 100% virgin furniture-grade polypropylene resin since 1993."
    },
    {
      "type": "text",
      "id": "social_facebook_link",
      "label": "Facebook URL",
      "default": "https://www.facebook.com/fellomouldedfurniture/"
    },
    {
      "type": "text",
      "id": "social_instagram_link",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/fello.pk/"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom navigation",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text (year is added automatically)",
      "default": "Polycraft Industries. All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Company"
        },
        {
          "type": "link_list",
          "id": "link_list",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "column", "settings": { "heading": "Products" } },
      { "type": "column", "settings": { "heading": "Company" } },
      { "type": "column", "settings": { "heading": "Get in Touch" } }
    ]
  }
}
{% endschema %}
