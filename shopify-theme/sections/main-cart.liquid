<div class="container" style="padding-block:3rem;">
  <h1 style="font-size:2rem; font-weight:800; color:var(--color-ink);">{{ 'general.cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <p class="empty-state__text">{{ 'cart.general.empty' | t }}</p>
      {%- render 'button', label: 'cart.general.continue_shopping' | t, url: routes.all_products_collection_url, size: 'lg' -%}
    </div>
  {%- else -%}
    {%- form 'cart', cart -%}
      <table class="cart-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td>
                <div class="cart-line">
                  <div class="cart-line__media">
                    {%- render 'image-or-art', image: item.image, icon: 'chair', tone: 'sand', label: item.title -%}
                  </div>
                  <div>
                    <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                    {%- if item.variant.title != 'Default Title' -%}
                      <p style="font-size:0.75rem; color:#737373;">{{ item.variant.title }}</p>
                    {%- endif -%}
                    <a href="{{ item.url_to_remove }}" class="cart-line__remove">{{ 'cart.general.remove' | t }}</a>
                  </div>
                </div>
              </td>
              <td>{{ item.original_price | money }}</td>
              <td>
                <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" style="width:4rem; border:1px solid rgba(0,0,0,0.1); border-radius:6px; padding:0.375rem 0.5rem;">
              </td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div class="cart-summary">
        <p class="cart-summary__subtotal">{{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}</p>
        <div style="display:flex; gap:0.75rem;">
          <button type="submit" name="update" class="btn btn--ghost btn--lg">{{ 'cart.general.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn--primary btn--lg">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
