<div class="container" style="padding-block:4rem; max-width:28rem; margin-inline:auto;">
  <h1 style="font-size:2rem; font-weight:800; color:var(--color-ink); text-align:center;">Reset Password</h1>
  <p style="margin-top:0.5rem; text-align:center; color:var(--color-body-text);">Enter a new password for {{ email }}.</p>

  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <p class="form-error" style="margin-top:1rem;">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="form-field" style="margin-top:1.5rem;">
      <label for="ResetPassword">New password</label>
      <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="form-field" style="margin-top:1.25rem;">
      <label for="ResetPasswordConfirm">Confirm new password</label>
      <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn--primary btn--lg btn--full" style="margin-top:1.5rem;">Reset Password</button>
  {%- endform -%}
</div>
