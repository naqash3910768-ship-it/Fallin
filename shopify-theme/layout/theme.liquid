<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_ink }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  {{ content_for_header }}

  {%- render 'json-ld-organization' -%}

  {%- if settings.use_custom_font -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  {%- else -%}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  {{ 'base.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    :root {
      --color-ink: {{ settings.color_ink }};
      --color-charcoal: {{ settings.color_charcoal }};
      --color-red: {{ settings.color_red }};
      --color-red-dark: {{ settings.color_red_dark }};
      --color-yellow: {{ settings.color_yellow }};
      --color-paper: {{ settings.color_paper }};
      --color-sand: {{ settings.color_sand }};
      --color-sand-dark: {{ settings.color_sand_dark }};
      --color-body-text: {{ settings.color_body_text }};
      --page-width: {{ settings.page_width }}px;
      --button-radius: {{ settings.button_radius }}px;
      {%- if settings.use_custom_font -%}
        --font-body: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
        --font-heading: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
      {%- else -%}
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-body-style: {{ settings.type_body_font.style }};
        --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-weight: {{ settings.type_header_font.weight }};
        --font-heading-style: {{ settings.type_header_font.style }};
      {%- endif -%}
    }
  {%- endstyle -%}
</head>
<body class="template-{{ request.page_type }}{% unless settings.enable_reveal_animations %} reveal-disabled{% endunless %}">
  <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important;}</style></noscript>

  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {% section 'header' %}

  <main id="MainContent" class="main-content">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'general.accessibility.refresh_page' | t | default: 'Choosing a selection results in a full page refresh.' }}</li>
  </ul>
</body>
</html>
