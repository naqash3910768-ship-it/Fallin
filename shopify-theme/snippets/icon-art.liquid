{%- comment -%}
  Renders the illustrative placeholder artwork system (line-art icon on a
  brand-toned background), used whenever a merchant has not yet uploaded a
  real photo for an image setting.

  Accepts:
    icon  — string: chair | armchair | stool | table | kids-chair | factory
                    | resin | mould | quality | finish | stack
    tone  — string: sand | ink | red | yellow | charcoal (default: sand)
    label — string: accessible label
    pattern — boolean: show dotted background pattern (default: true)
{%- endcomment -%}
{%- liquid
  assign icon = icon | default: 'chair'
  assign tone = tone | default: 'sand'
  assign show_pattern = true
  if pattern == false
    assign show_pattern = false
  endif
  assign label = label | default: 'Fello moulded furniture — illustrative artwork'
-%}
{%- capture art_pattern_counter -%}{%- increment art_pattern_seed -%}{%- endcapture -%}
{%- liquid
  assign pattern_id = 'art-grid-' | append: art_pattern_counter
-%}
<div class="art art--tone-{{ tone }}" role="img" aria-label="{{ label | escape }}">
  {%- if show_pattern -%}
    <svg class="art__pattern" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <pattern id="{{ pattern_id }}" width="22" height="22" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="1.5" class="art__pattern-dot"></circle>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#{{ pattern_id }})"></rect>
    </svg>
  {%- endif -%}

  <svg class="art__icon" viewBox="0 0 100 100" aria-hidden="true">
    {%- case icon -%}
      {%- when 'chair' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M30 20 L30 62 Q30 68 36 68 L64 68 Q70 68 70 62 L70 46"></path>
          <path d="M30 46 L70 46"></path>
          <path d="M30 20 Q30 14 36 14 L58 14 Q64 14 64 20 L64 46"></path>
          <path d="M34 68 L30 84 M66 68 L70 84"></path>
          <circle cx="76" cy="34" r="4" stroke="none"></circle>
        </g>
      {%- when 'armchair' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M24 50 L24 66 Q24 70 28 70 L72 70 Q76 70 76 66 L76 50"></path>
          <path d="M24 50 Q24 30 30 26 L30 44"></path>
          <path d="M76 50 Q76 30 70 26 L70 44"></path>
          <path d="M30 26 Q30 16 40 16 L60 16 Q70 16 70 26 L70 44 L30 44 Z"></path>
          <path d="M28 70 L26 84 M72 70 L74 84"></path>
          <circle cx="50" cy="30" r="3.5" stroke="none"></circle>
        </g>
      {%- when 'stool' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="50" cy="26" rx="26" ry="8"></ellipse>
          <path d="M26 26 L34 78 M74 26 L66 78 M50 34 L50 78"></path>
          <path d="M30 52 L70 52"></path>
          <circle cx="50" cy="26" r="3.5" stroke="none"></circle>
        </g>
      {%- when 'table' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="50" cy="30" rx="34" ry="9"></ellipse>
          <path d="M20 30 L28 80 M80 30 L72 80 M50 39 L50 80"></path>
          <path d="M24 58 L76 58"></path>
          <circle cx="50" cy="30" r="3.5" stroke="none"></circle>
        </g>
      {%- when 'kids-chair' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M36 30 L36 60 Q36 64 40 64 L60 64 Q64 64 64 60 L64 50"></path>
          <path d="M36 50 L64 50"></path>
          <path d="M36 30 Q36 26 40 26 L56 26 Q60 26 60 30 L60 50"></path>
          <path d="M40 64 L37 80 M60 64 L63 80"></path>
          <circle cx="50" cy="18" r="6" stroke="none"></circle>
        </g>
      {%- when 'factory' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 78 L18 46 L34 56 L34 42 L50 52 L50 34 L82 34 L82 78 Z"></path>
          <path d="M18 78 L82 78"></path>
          <path d="M62 34 L62 22 L70 22 L70 34"></path>
          <circle cx="66" cy="16" r="3" stroke="none"></circle>
        </g>
      {%- when 'resin' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M50 16 L50 34"></path>
          <path d="M38 34 L62 34 L72 78 L28 78 Z"></path>
          <path d="M34 58 L66 58"></path>
          <circle cx="50" cy="66" r="4" stroke="none"></circle>
        </g>
      {%- when 'mould' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <rect x="20" y="24" width="26" height="52" rx="2"></rect>
          <rect x="54" y="24" width="26" height="52" rx="2"></rect>
          <path d="M46 40 L54 40 M46 60 L54 60"></path>
          <circle cx="50" cy="50" r="3" stroke="none"></circle>
        </g>
      {%- when 'quality' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M50 16 L78 26 L78 50 Q78 72 50 84 Q22 72 22 50 L22 26 Z"></path>
          <path d="M38 50 L48 60 L64 40"></path>
        </g>
      {%- when 'finish' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="50" cy="50" r="30"></circle>
          <path d="M50 26 L50 50 L66 60"></path>
          <circle cx="50" cy="50" r="3" stroke="none"></circle>
        </g>
      {%- when 'stack' -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M28 30 L28 58 Q28 62 32 62 L68 62 Q72 62 72 58 L72 30"></path>
          <path d="M28 42 Q50 50 72 42"></path>
          <path d="M28 30 Q50 38 72 30 Q50 22 28 30 Z"></path>
          <path d="M32 62 L30 78 M68 62 L70 78"></path>
        </g>
      {%- else -%}
        <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M30 20 L30 62 Q30 68 36 68 L64 68 Q70 68 70 62 L70 46"></path>
          <path d="M30 46 L70 46"></path>
        </g>
    {%- endcase -%}
  </svg>
</div>
